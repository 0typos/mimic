#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "typer>=0.16,<1",
# ]
# ///
"""Manage the disposable Docker Compose environment for the Mimic tutorial.

Builds Mimic, starts deterministic modern and legacy TLS origins, generates a
lab-only interception CA, and exercises every documented proxy path. `install`
symlinks this script onto PATH so `mimic-lab up` works from any directory.
"""

from __future__ import annotations

import json
import os
import shlex
import shutil
import socket
import subprocess
import sys
import time
from collections.abc import Sequence
from pathlib import Path
from typing import Annotated, NoReturn

import typer

LAB_DIR = Path(__file__).resolve().parent
STATE_DIR = LAB_DIR / ".state"
COMPOSE_FILE = LAB_DIR / "compose.yaml"
CA_CERT = STATE_DIR / "mimic-ca.pem"
COMMAND = "mimic-lab"


class LabError(RuntimeError):
    """An expected, user-actionable lab error."""


def note(message: str) -> None:
    print(f"{COMMAND}: {message}", flush=True)


def fail(message: str) -> NoReturn:
    raise LabError(message)


def require_command(name: str) -> str:
    path = shutil.which(name)
    if path is None:
        fail(f"required command not found: {name}")
    return path


def launcher_command() -> str:
    installed = shutil.which(COMMAND)
    if installed is not None and Path(installed).resolve() == Path(__file__).resolve():
        return COMMAND
    return shlex.quote(sys.argv[0])


def run(
    command: Sequence[str | os.PathLike[str]],
    *,
    capture_output: bool = False,
    quiet: bool = False,
    check: bool = True,
) -> subprocess.CompletedProcess[str]:
    argv = [os.fspath(part) for part in command]
    try:
        result = subprocess.run(
            argv,
            check=False,
            text=True,
            capture_output=capture_output and not quiet,
            stdout=subprocess.DEVNULL if quiet else None,
            stderr=subprocess.DEVNULL if quiet else None,
        )
    except FileNotFoundError:
        fail(f"required command not found: {argv[0]}")
    if check and result.returncode != 0:
        detail = result.stderr.strip() if capture_output and result.stderr else ""
        suffix = f": {detail}" if detail else ""
        fail(
            f"command failed with status {result.returncode}: "
            f"{shlex.join(argv)}{suffix}"
        )
    return result


def compose(
    *arguments: str, capture_output: bool = False, quiet: bool = False
) -> subprocess.CompletedProcess[str]:
    return run(
        ["docker", "compose", "-f", COMPOSE_FILE, *arguments],
        capture_output=capture_output,
        quiet=quiet,
    )


def captured(command: Sequence[str | os.PathLike[str]]) -> str:
    return run(command, capture_output=True).stdout


def control(*arguments: str, quiet: bool = False) -> str:
    command = [
        "docker",
        "compose",
        "-f",
        COMPOSE_FILE,
        "exec",
        "-T",
        "mimic",
        "mimic",
        "ctl",
        "-socket",
        "tcp://127.0.0.1:9090",
        *arguments,
    ]
    if quiet:
        run(command, quiet=True)
        return ""
    return captured(command)


def host_control(method: str, params: dict[str, object] | None = None) -> object:
    """Call the lab-only host control forward used by the Caido plugin UI."""
    request_id = time.time_ns()
    request = json.dumps(
        {"id": request_id, "method": method, "params": params or {}},
        separators=(",", ":"),
    ).encode()
    try:
        with socket.create_connection(("127.0.0.1", 9090), timeout=5) as connection:
            connection.sendall(request + b"\n")
            with connection.makefile("rb") as response_file:
                response_line = response_file.readline(1024 * 1024 + 1)
    except OSError as error:
        fail(f"host control forward is unavailable: {error}")
    if not response_line or len(response_line) > 1024 * 1024:
        fail("host control forward returned an invalid response")
    try:
        response = json.loads(response_line)
    except json.JSONDecodeError as error:
        fail(f"host control forward returned invalid JSON: {error}")
    if not isinstance(response, dict):
        fail("host control forward returned a non-object response")
    if response.get("id") != request_id:
        fail("host control forward returned a mismatched response")
    if response.get("error"):
        fail(f"host control forward returned an error: {response['error']}")
    if "result" not in response:
        fail("host control forward returned no result")
    return response["result"]


def probe(*arguments: str, stream: bool = False) -> str:
    command = [
        "docker",
        "compose",
        "-f",
        COMPOSE_FILE,
        "exec",
        "-T",
        "mimic",
        "mimic",
        "probe",
        "-config",
        "/etc/mimic/config.toml",
        *arguments,
    ]
    if stream:
        run(command)
        return ""
    return captured(command)


def curl(*arguments: str, insecure: bool = False) -> str:
    command = ["curl", "--silent", "--show-error", "--fail"]
    if insecure:
        command.append("--insecure")
    command.extend(arguments)
    return captured(command)


def http_request(url: str) -> str:
    return curl(
        "--noproxy",
        "",
        "--proxy",
        "http://127.0.0.1:18080",
        url,
    )


def intercept_request(url: str) -> str:
    return curl(
        "--noproxy",
        "",
        "--proxy",
        "http://127.0.0.1:18081",
        "--cacert",
        CA_CERT,
        url,
    )


def assert_contains(output: str, expected: str, label: str) -> None:
    if expected not in output:
        fail(f"{label}: expected {expected!r} in output:\n{output}")
    print(f"PASS: {label}", flush=True)


def assert_positive_counter(output: str, field: str, label: str) -> None:
    try:
        value = json.loads(output)[field]
    except (json.JSONDecodeError, KeyError, TypeError) as error:
        fail(f"{label}: cannot read {field!r} from status: {error}")
    if not isinstance(value, int) or value < 1:
        fail(f"{label}: expected a positive {field}, got {value!r}")
    print(f"PASS: {label}", flush=True)


def uv_executable_dir() -> Path:
    require_command("uv")
    result = run(["uv", "tool", "dir", "--bin"], capture_output=True)
    value = result.stdout.strip()
    if not value:
        fail("uv did not report its executable directory")
    return Path(value).expanduser().resolve()


def install_launcher(*, force: bool) -> None:
    source = Path(__file__).resolve()
    bin_dir = uv_executable_dir()
    target = bin_dir / COMMAND
    bin_dir.mkdir(parents=True, exist_ok=True)
    if target.is_symlink() and target.resolve() == source:
        note(f"command already installed at {target}")
        return
    if target.exists() or target.is_symlink():
        if not force:
            fail(f"{target} already exists; inspect it or rerun install with --force")
        if target.is_dir() and not target.is_symlink():
            fail(f"refusing to replace directory {target}")
        target.unlink()
    target.symlink_to(source)
    note(f"installed command: {target} -> {source}")
    entries = [
        Path(entry).expanduser().resolve()
        for entry in os.environ.get("PATH", "").split(os.pathsep)
        if entry
    ]
    if bin_dir not in entries:
        note("uv's executable directory is not on PATH; run: uv tool update-shell")
    else:
        note(f"ready: {COMMAND} up")


def uninstall_launcher() -> None:
    source = Path(__file__).resolve()
    target = uv_executable_dir() / COMMAND
    if not target.is_symlink():
        fail(
            f"refusing to remove {target}; it is not a symlink installed by this script"
        )
    if target.resolve() != source:
        fail(f"refusing to remove {target}; it points to a different command")
    target.unlink()
    note(f"removed command {target}")


app = typer.Typer(
    help="The Mimic tutorial lab: deterministic HTTP, modern TLS, and legacy TLS.",
    no_args_is_help=True,
    add_completion=False,
)


@app.command()
def up() -> None:
    """Build and start the lab, waiting up to three minutes for readiness."""
    require_command("docker")
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    started = time.monotonic()
    compose("up", "--build", "--detach", "--wait", "--wait-timeout", "180")
    host_control("ping")
    elapsed = round(time.monotonic() - started)
    note(f"ready in {elapsed}s; run: {launcher_command()} demo")


@app.command()
def demo() -> None:
    """Run the three-step, sub-five-minute guided demonstration."""
    require_command("docker")
    require_command("curl")
    print(
        "1/3  Prove the configured Chrome ClientHello matches its expected JA4",
        flush=True,
    )
    probe(
        "-profile", "chrome-152-linux", "-target", "modern-origin:8443", stream=True
    )

    print(
        "\n2/3  Send plaintext HTTP through Mimic and inspect its HTTP identity",
        flush=True,
    )
    print(
        http_request("http://default-origin:8080/inspect?via=quickstart"),
        end="",
        flush=True,
    )

    print(
        "\n3/3  Let Mimic intercept HTTPS and originate the upstream TLS connection",
        flush=True,
    )
    print(
        intercept_request("https://modern-origin:8443/inspect?via=quickstart"),
        end="",
        flush=True,
    )
    print(
        "\nSuccess: JA4 conformance, profiled HTTP, and HTTPS interception worked.",
        flush=True,
    )


@app.command("check")
def check_lab() -> None:
    """Exercise every lab transport, profile, route, and control workflow."""
    require_command("docker")
    require_command("curl")
    note("running the complete workflow")

    host_status = host_control("status")
    if not isinstance(host_status, dict) or not host_status.get("profile"):
        fail(f"Caido UI control path returned invalid status: {host_status!r}")
    print("PASS: Caido UI reaches the daemon control endpoint", flush=True)

    output = probe(
        "-profile",
        "chrome-152-linux",
        "-target",
        "modern-origin:8443",
        "-format",
        "json",
    )
    assert_contains(output, '"status": "pass"', "modern ClientHello matches Chrome JA4")
    assert_contains(
        output,
        '"negotiated_version": "TLS1.3"',
        "modern origin negotiates TLS 1.3",
    )

    output = http_request("http://default-origin:8080/inspect?via=http")
    assert_contains(
        output,
        "Chrome/152.0.0.0",
        "HTTP proxy applies the default profile identity",
    )

    control("use", "lab-firefox", quiet=True)
    output = http_request("http://default-origin:8080/inspect?via=live-profile")
    assert_contains(
        output, "Firefox/120.0", "control API changes the live default profile"
    )
    assert_contains(output, "lab-firefox", "custom profile headers reach the origin")

    output = intercept_request("https://modern-origin:8443/inspect?via=route")
    assert_contains(output, "Chrome/152.0.0.0", "host route overrides the live default")
    assert_contains(
        output, '"tls":"TLS1.3"', "interception creates modern upstream TLS"
    )

    control("use", "chrome-152-linux", quiet=True)
    output = probe("-target", "legacy-origin:9443", "-format", "json")
    assert_contains(
        output, '"legacy": true', "eligible TLS failure triggers the bounded fallback"
    )
    assert_contains(
        output, '"negotiated_version": "TLS1.0"', "legacy endpoint negotiates TLS 1.0"
    )

    output = intercept_request("https://legacy-origin:9443/inspect?via=legacy")
    assert_contains(
        output, '"tls":"TLS1.0"', "intercepted request reaches the legacy origin"
    )

    output = curl(
        "--noproxy",
        "",
        "--socks5-hostname",
        "127.0.0.1:11080",
        "https://modern-origin:8443/inspect?via=socks",
        insecure=True,
    )
    assert_contains(output, "curl/", "SOCKS preserves the client HTTP/TLS identity")

    output = captured(
        [
            "docker",
            "compose",
            "-f",
            COMPOSE_FILE,
            "exec",
            "-T",
            "mimic",
            "/usr/local/bin/lab-origin",
            "unix-check",
            "/etc/mimic/.state/http.sock",
            "default-origin:8080",
        ]
    )
    assert_contains(
        output,
        '"path":"/inspect?via=unix"',
        "Unix-socket HTTP listener forwards requests",
    )
    assert_contains(
        output, "Chrome/152.0.0.0", "Unix-socket listener applies the active profile"
    )

    control("log-level", "debug", quiet=True)
    output = captured(
        [
            "docker",
            "compose",
            "-f",
            COMPOSE_FILE,
            "exec",
            "-T",
            "origin",
            "/lab-origin",
            "caido-check",
            "mimic:7777",
            "modern-origin:8443",
            "lab-firefox",
        ]
    )
    assert_contains(
        output,
        '"path":"/inspect?via=caido"',
        "Caido bridge relays the plaintext request",
    )
    assert_contains(output, '"tls":"TLS1.3"', "Caido bridge originates upstream TLS")
    logs = compose("logs", "--no-color", "mimic", capture_output=True).stdout
    assert_contains(
        logs, "profile=lab-firefox", "Caido preface selects its TLS profile"
    )
    control("log-level", "info", quiet=True)

    status_output = control("status")
    assert_positive_counter(
        status_output,
        "tls_fallbacks",
        "daemon status counts legacy fallbacks",
    )
    note("all checks passed")


@app.command(hidden=True)
def smoke() -> None:
    """Compatibility alias for `check`."""
    check_lab()


@app.command()
def status() -> None:
    """Show daemon profile, counters, configuration, and uptime."""
    require_command("docker")
    print(control("status"), end="")


@app.command()
def profiles() -> None:
    """List the profiles loaded by the running daemon."""
    require_command("docker")
    print(control("profiles"), end="")


@app.command()
def logs() -> None:
    """Follow Mimic daemon logs until interrupted."""
    require_command("docker")
    compose("logs", "--follow", "mimic")


@app.command()
def down() -> None:
    """Remove the lab containers and network, preserving the generated CA."""
    require_command("docker")
    compose("down", "--remove-orphans")
    note("down; generated CA state preserved")


@app.command()
def install(
    force: Annotated[
        bool,
        typer.Option("--force", help="Replace an existing non-directory command"),
    ] = False,
) -> None:
    """Symlink `mimic-lab` into uv's executable directory."""
    install_launcher(force=force)


@app.command()
def uninstall() -> None:
    """Remove this checkout's installed `mimic-lab` symlink."""
    uninstall_launcher()


def main() -> None:
    try:
        app()
    except LabError as error:
        typer.echo(f"{COMMAND}: {error}", err=True)
        raise SystemExit(1) from None
    except KeyboardInterrupt:
        typer.echo(f"\n{COMMAND}: interrupted", err=True)
        raise SystemExit(130) from None


if __name__ == "__main__":
    main()
