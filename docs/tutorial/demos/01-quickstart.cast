[0.008357, "o", "\r\n\u001b[2;36m# One command proves the ClientHello, profiled HTTP, and intercepted HTTPS.\u001b[0m\r\n"]
[0.310805, "o", "\u001b[2;36m# Every destination is a deterministic container inside the disposable lab.\u001b[0m\r\n"]
